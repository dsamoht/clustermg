/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output paths are declared in the `output` block of main.nf (Nextflow workflow
    outputs), not with publishDir directives.
----------------------------------------------------------------------------------------
*/

process {

    // --------------------------------------------------------- Gene prediction
    withName: 'PYRODIGAL' {
        ext.args = '-p meta'
    }

    // ------------------------------------------------------- MAG dereplication
    withName: 'FILTER_MAGS' {
        ext.args = { "--min-completeness ${params.mag_min_completeness} --max-contamination ${params.mag_max_contamination} --min-length ${params.mag_min_length}" }
    }
    // dRep is given the thresholds FILTER_MAGS applied, so its own filter removes nothing
    withName: 'DREP' {
        ext.args = { "-sa ${params.mag_ani} -comp ${params.mag_min_completeness} -con ${params.mag_max_contamination} -l ${params.mag_min_length} --S_algorithm skani --skip_plots" }
    }
    // dRep runs with its default -nc (0.1), which MAG_LEVELS must apply as well to rebuild
    // dRep's tree; give both the same value if DREP gets another one
    withName: 'MAG_LEVELS' {
        ext.args = { "--fine-ani ${params.mag_ani_fine} --cov-thresh 0.1" }
    }

    // ------------------------------------------------------------ Gene catalog
    // `--cluster-reassign` moves a member that cascaded clustering left below the
    // thresholds of its own representative, so that every member meets them.
    withName: 'MMSEQS_EASYCLUSTER_MAG|MMSEQS_EASYCLUSTER_OTHER' {
        ext.args = { "--min-seq-id ${params.gene_min_seq_id} -c ${params.gene_coverage} --cov-mode ${params.gene_cov_mode} --cluster-reassign 1" }
    }
    withName: 'MMSEQS_EASYCLUSTER_MAG' {
        ext.prefix = 'final_mag_genes'
    }
    withName: 'MMSEQS_EASYCLUSTER_OTHER' {
        ext.prefix = 'other_genes'
    }
    // In clustering the member is the target of the alignment; here it is the query, so
    // the coverage mode is mirrored for "member coverage" to mean the same in every step.
    withName: 'MMSEQS_EASYSEARCH' {
        ext.args = { "--min-seq-id ${params.gene_min_seq_id} -c ${params.gene_coverage} --cov-mode ${[0, 2, 1][params.gene_cov_mode as int]} --alignment-mode 3" }
    }

    // ------------------------------------------------------------ Read mapping
    // `-c` computes the alignments, whose matches give the identity of a link
    withName: 'MINIMAP2_ALIGN_CONTIGS' {
        ext.args   = '-cx asm10 --secondary=no'
        ext.prefix = 'links'
    }
    withName: 'LINK_CONTIGS' {
        ext.args = { "--min-identity ${params.link_min_identity} --min-length ${params.link_min_length}" }
    }
    // Only the primary alignment of a read is counted: secondary ones would only fill the BAM,
    // the more as the same genome is in the reference several times over
    withName: 'MINIMAP2_ALIGN' {
        ext.args = '--secondary=no'
    }
    // A read is rRNA as soon as it aligns once to the databases
    withName: 'SORTMERNA' {
        ext.args = '--num_alignments 1 -v'
    }
    // A fragment over several genes (an operon) is split between them, so that a library's gene
    // counts add up to its assigned fragments; AGGREGATE_COUNTS stops the run otherwise
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args = '--primary -O --fraction'
    }
    // CoverM's genome default (10%) would turn a MAG covered on less than a tenth into 0
    withName: 'COVERM_GENOME' {
        ext.args = '--methods count mean trimmed_mean covered_fraction --min-covered-fraction 0'
    }
}
