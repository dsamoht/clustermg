{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/dsamoht/clustermg/main/assets/schema_reads.json",
    "title": "dsamoht/clustermg pipeline - params.reads schema",
    "description": "Schema for the file provided with params.reads",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "library": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Library id must be provided and may only contain letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Sample id must be provided and may only contain letters, digits, '.', '_' and '-': it links the library to the 'samples' of the assemblies",
                "meta": ["sample"]
            },
            "molecule": {
                "type": "string",
                "enum": ["dna", "rna"],
                "errorMessage": "Molecule must be 'dna' or 'rna'",
                "meta": ["molecule"]
            },
            "platform": {
                "type": "string",
                "enum": ["ont", "pacbio", "illumina"],
                "errorMessage": "Platform must be 'ont', 'pacbio' or 'illumina'",
                "meta": ["platform"]
            },
            "fastq_1": {
                "type": "string",
                "pattern": "^\\S+\\.f(ast)?q(\\.gz)?$",
                "errorMessage": "Reads must be FastQ ('.fq' or '.fastq', optionally gzipped) and the path cannot contain spaces"
            },
            "fastq_2": {
                "type": "string",
                "pattern": "^\\S+\\.f(ast)?q(\\.gz)?$",
                "errorMessage": "Mates must be FastQ ('.fq' or '.fastq', optionally gzipped) and the path cannot contain spaces"
            },
            "strandedness": {
                "type": "string",
                "enum": ["unstranded", "forward", "reverse"],
                "errorMessage": "Strandedness must be 'unstranded', 'forward' or 'reverse'",
                "meta": ["strandedness"]
            }
        },
        "required": ["library", "sample", "molecule", "platform", "fastq_1"]
    },
    "uniqueEntries": ["library"]
}
